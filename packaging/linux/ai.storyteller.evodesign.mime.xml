<?xml version="1.0" encoding="UTF-8"?>
<!-- Installed as share/mime/packages/ai.storyteller.evodesign.xml (package.sh, the Flatpak
     manifests). Both formats are zip files, so they are matched by extension: zip magic would
     claim every archive. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-evodesign">
    <comment>EvoDesign document</comment>
    <sub-class-of type="application/zip"/>
    <generic-icon name="ai.storyteller.evodesign"/>
    <glob pattern="*.evodesign"/>
  </mime-type>
  <mime-type type="application/vnd.adobe.indesign-idml-package">
    <comment>IDML document</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.idml"/>
  </mime-type>
</mime-info>
